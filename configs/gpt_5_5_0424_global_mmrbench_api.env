# Runtime config for gpt-5.5-0424-global through Alibaba internal chat API.

# shellcheck source=/dev/null
source "${REPO_ROOT}/configs/alibaba_chat_api_mmrbench.env"

MODEL="gpt-5.5-0424-global"
MODEL_PATH="api:gpt-5.5-0424-global"
MODEL_CLASS="AlibabaChatAPI"

# Keep closed-model main-table runs at 4096 output tokens.
# sleep_every/sleep_seconds throttle the model API worker after every 800 samples.
MODEL_ARGS_JSON='{"model":"gpt-5.5-0424-global","api_base":"https://llm-chat-api.alibaba-inc.com/v1/api/chat","app":"llm_evaluation","max_tokens":4096,"retry":5,"timeout":600,"verbose":false,"sleep_every":800,"sleep_seconds":1200}'

CSV_PATH="${REPO_ROOT}/data/MMR-Bench.csv"
BENCHMARK_REGISTRY="${REPO_ROOT}/configs/mmrbench_benchmark_registry.json"
BENCHMARKS="MMStar,RealWorldQA,SEEDBench2_Plus,OCRBench,MathVista_MINI,MathVision,MathVerse_MINI_Vision_Only"

# API model merge is done manually after validating prediction quality.
MERGE_MODE="never"

JUDGE_MODEL="Qwen3.5-122B-A10B"
JUDGE_IP="33.41.7.100"
JUDGE_PORT="8000"
JUDGE_BASE_URL=""
JUDGE_KEY="EMPTY"
JUDGE_NPROC="1"
JUDGE_RETRY="2"
JUDGE_TIMEOUT="900"
JUDGE_ARGS='{"temperature":0,"chat_template_kwargs":{"enable_thinking":false}}'
MMR_JUDGE_IP="${JUDGE_IP}"
MMR_JUDGE_PORT="${JUDGE_PORT}"
MMR_JUDGE_BASE_URL="http://${JUDGE_IP}:${JUDGE_PORT}/v1"
MMR_JUDGE_NPROC="${JUDGE_NPROC}"

# API inference: one launcher process, one concurrent API request.
GPUS=""
NPROC="1"
MASTER_PORT="29601"
USE_VLLM="0"
USE_COT="0"
API_NPROC="1"
PREWARM_REMOTE_CODE="0"
REUSE="0"
REUSE_AUX="all"
MMR_SLEEP_BETWEEN_SECONDS="0"

LOG_DIR="${REPO_ROOT}/logs"
WORK_DIR=""
