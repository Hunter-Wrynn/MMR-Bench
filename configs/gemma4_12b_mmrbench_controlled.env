# Runtime config for Gemma4-12B-it on MMR-Bench.
# CLI options passed to the runner override values here.

MODEL="Gemma4-12B-it"
MODEL_PATH="/root/storage/mahaoxuan.mhx/model/Gemma-4-12B-it"
MODEL_CLASS="Gemma4"
CONDA_ENV="/root/storage/miniconda3/envs/vlmevalkit_gemma4"
MODEL_ARGS_JSON='{"device_map":"cuda:0","max_new_tokens":4096,"do_sample":false,"temperature":0.0,"top_p":1.0,"top_k":1,"enable_thinking":false,"limit_mm_per_prompt":24,"trust_remote_code":true}'
CSV_PATH="${REPO_ROOT}/data/MMR-Bench.csv"

BENCHMARK_REGISTRY="${REPO_ROOT}/configs/mmrbench_benchmark_registry.json"
BENCHMARKS="MMStar,RealWorldQA,SEEDBench2_Plus,OCRBench,MathVista_MINI,MathVision,MathVerse_MINI_Vision_Only"
MERGE_MODE="auto"

JUDGE_MODEL="Qwen3.5-122B-A10B"
JUDGE_IP="33.41.7.100"
JUDGE_PORT="8000"
JUDGE_BASE_URL=""
JUDGE_KEY="EMPTY"
JUDGE_NPROC="8"
JUDGE_RETRY="2"
JUDGE_TIMEOUT="900"
JUDGE_ARGS='{"temperature":0,"chat_template_kwargs":{"enable_thinking":false}}'

GPUS="0,1,2,3,4,5,6,7"
NPROC=""
MASTER_PORT="29673"
MODE="all"
USE_VLLM="0"
USE_COT="1"
API_NPROC="1"

LOG_DIR="${REPO_ROOT}/logs"
WORK_DIR=""
