# Runtime config for Claude Opus 4.7 through Alibaba internal chat API.
# This intentionally reuses the credential exports from the generic Alibaba config,
# then overrides model/runtime settings that differ from gpt-5.4.

# shellcheck source=/dev/null
source "${REPO_ROOT}/configs/alibaba_chat_api_mmrbench.env"

MODEL="claude-opus-4-7"
MODEL_PATH="api:claude-opus-4-7"
MODEL_CLASS="AlibabaChatAPI"

# Claude Opus 4.7 rejects `temperature`; do not add temperature/top_p/top_k here.
MODEL_ARGS_JSON='{"model":"claude-opus-4-7","api_base":"https://llm-chat-api.alibaba-inc.com/v1/api/chat","app":"llm_evaluation","max_tokens":4096,"retry":5,"timeout":600,"verbose":false}'

CSV_PATH="${REPO_ROOT}/data/MMR-Bench.csv"
BENCHMARK_REGISTRY="${REPO_ROOT}/configs/mmrbench_benchmark_registry.json"
BENCHMARKS="MMStar,RealWorldQA,SEEDBench2_Plus,OCRBench,MathVista_MINI,MathVision,MathVerse_MINI_Vision_Only"

# Keep automatic merge disabled for API models until token accounting supports api:* paths.
MERGE_MODE="never"

JUDGE_MODEL="Qwen3.5-122B-A10B"
JUDGE_IP="33.41.7.100"
JUDGE_PORT="8000"
JUDGE_BASE_URL=""
JUDGE_KEY="EMPTY"
JUDGE_NPROC="2"
JUDGE_RETRY="2"
JUDGE_TIMEOUT="900"
JUDGE_ARGS='{"temperature":0,"chat_template_kwargs":{"enable_thinking":false}}'
MMR_JUDGE_IP="${JUDGE_IP}"
MMR_JUDGE_PORT="${JUDGE_PORT}"
MMR_JUDGE_BASE_URL="http://${JUDGE_IP}:${JUDGE_PORT}/v1"
MMR_JUDGE_NPROC="${JUDGE_NPROC}"

# API inference: one launcher process, two concurrent API requests.
GPUS=""
NPROC="1"
MASTER_PORT="29581"
USE_VLLM="0"
USE_COT="0"
API_NPROC="2"
PREWARM_REMOTE_CODE="0"
REUSE="0"
REUSE_AUX="all"

LOG_DIR="${REPO_ROOT}/logs"
WORK_DIR=""
