# Runtime config for Ovis2.5-9B on MMR-Bench.
# Ovis2.5 uses its VLMEvalKit vLLM adapter internally; this config keeps the
# MMR-Bench main-table protocol non-thinking and caps responses at 4096 tokens.

MODEL="Ovis2.5-9B"
MODEL_PATH="/root/storage/mahaoxuan.mhx/model/Ovis2.5-9B"
MODEL_CLASS="Ovis2_5"
MODEL_ARGS_JSON='{"enable_thinking":false,"max_new_tokens":4096,"thinking_budget":3072,"min_pixels":1048576,"max_pixels":3211264,"gpu_memory_utilization":0.7}'
CSV_PATH="${REPO_ROOT}/data/MMR-Bench.csv"

BENCHMARK_REGISTRY="${REPO_ROOT}/configs/mmrbench_benchmark_registry.json"
BENCHMARKS="MMStar,RealWorldQA,SEEDBench2_Plus,OCRBench,MathVista_MINI,MathVision,MathVerse_MINI_Vision_Only"
MERGE_MODE="auto"

JUDGE_MODEL="Qwen3.5-122B-A10B"
JUDGE_IP="33.41.7.100"
JUDGE_PORT="8000"
JUDGE_BASE_URL=""
JUDGE_KEY="EMPTY"
JUDGE_NPROC="8"
JUDGE_RETRY="2"
JUDGE_TIMEOUT="900"
JUDGE_ARGS='{"temperature":0,"chat_template_kwargs":{"enable_thinking":false}}'

GPUS="0,1,2,3,4,5,6,7"
NPROC="8"
MASTER_PORT="29671"
MODE="all"
USE_VLLM="0"
USE_COT="1"
API_NPROC="1"
PREWARM_REMOTE_CODE="1"

LOG_DIR="${REPO_ROOT}/logs"
WORK_DIR=""
