# Runtime config for closed-model inference through Alibaba internal chat API.
# Alibaba API credentials are intentionally embedded in this repo config.
# Runner subprocesses read them through environment variables.
# Optional:
#   ALIBABA_LLM_CHAT_MODEL      default: gpt-5.4-0305-global
#   ALIBABA_LLM_CHAT_API_BASE   default: https://llm-chat-api.alibaba-inc.com/v1/api/chat
#   ALIBABA_LLM_CHAT_APP        default: llm_evaluation

export ALIBABA_LLM_CHAT_ACCESS_KEY="${ALIBABA_LLM_CHAT_ACCESS_KEY:-efc8c9ca4ac5b0dd4018bcd3a83d767d}"
export ALIBABA_LLM_CHAT_QUOTA_ID="${ALIBABA_LLM_CHAT_QUOTA_ID:-a1f19d3f-bce0-47b3-ac6c-1aff3e6aec0d}"
export ALIBABA_LLM_CHAT_USER_ID="${ALIBABA_LLM_CHAT_USER_ID:-345245}"
export ALIBABA_LLM_CHAT_APP="${ALIBABA_LLM_CHAT_APP:-llm_evaluation}"

MODEL="${ALIBABA_LLM_CHAT_MODEL:-gpt-5.4-0305-global}"
MODEL_PATH="api:${ALIBABA_LLM_CHAT_MODEL:-gpt-5.4-0305-global}"
MODEL_CLASS="AlibabaChatAPI"
MODEL_ARGS_JSON="{\"model\":\"${ALIBABA_LLM_CHAT_MODEL:-gpt-5.4-0305-global}\",\"api_base\":\"${ALIBABA_LLM_CHAT_API_BASE:-https://llm-chat-api.alibaba-inc.com/v1/api/chat}\",\"app\":\"${ALIBABA_LLM_CHAT_APP:-llm_evaluation}\",\"max_tokens\":4096,\"temperature\":0,\"retry\":5,\"timeout\":300,\"verbose\":false}"
CSV_PATH="${REPO_ROOT}/data/MMR-Bench.csv"

BENCHMARK_REGISTRY="${REPO_ROOT}/configs/mmrbench_benchmark_registry.json"
BENCHMARKS="MMStar,RealWorldQA,SEEDBench2_Plus,OCRBench,MathVista_MINI,MathVision,MathVerse_MINI_Vision_Only"
MERGE_MODE="auto"

JUDGE_MODEL="Qwen3.5-122B-A10B"
JUDGE_IP="33.41.7.100"
JUDGE_PORT="8000"
JUDGE_BASE_URL=""
JUDGE_KEY="EMPTY"
JUDGE_NPROC="8"
JUDGE_RETRY="2"
JUDGE_TIMEOUT="900"
JUDGE_ARGS='{"temperature":0,"chat_template_kwargs":{"enable_thinking":false}}'

# API inference does not need local GPU. Keep one launcher process and use API_NPROC
# for VLMEvalKit's internal request parallelism.
GPUS=""
NPROC="1"
MASTER_PORT="29551"
USE_VLLM="0"
USE_COT="1"
API_NPROC="8"
PREWARM_REMOTE_CODE="0"

LOG_DIR="${REPO_ROOT}/logs"
WORK_DIR=""
