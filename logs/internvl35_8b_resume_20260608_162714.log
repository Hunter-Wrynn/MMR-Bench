  - \((x_1, y_1) \rightarrow (-y_1, x_1)\)
  - \((x_2, y_2) \rightarrow (-y_2, x_2)\)
  - \((x_3, y_3) \rightarrow (-y_3, x_3)\)
  - \((x_4, y_4) \rightarrow (-y_4, x_4)\)

